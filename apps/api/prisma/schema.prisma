// ALL ROADS — Prisma schema
// Cubre los 10 módulos de la plataforma.
// Provider: PostgreSQL (recomendado para Railway/Render/Supabase).
// Para desarrollo local, ver docker-compose.yml.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH / USUARIOS / ROLES
// ============================================================

enum Role {
  ADMIN
  OPERACIONES
  GESTION_HUMANA
  MANTENIMIENTO
  CONSULTA
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  fullName    String
  role        Role     @default(CONSULTA)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs   AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE | UPDATE | DELETE | LOGIN | etc.
  entity     String   // Vehicle | Driver | Service | ...
  entityId   String?
  data       String?  // JSON-stringified payload
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

// ============================================================
// MÓDULO 1 — VEHÍCULOS
// ============================================================

enum VehicleStatus {
  DISPONIBLE
  EN_SERVICIO
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Vehicle {
  id                 String        @id @default(cuid())
  placa              String        @unique
  numeroInterno      String?
  tipo               String        // Sedán, SUV, Van, Bus, Camión...
  marca              String
  linea              String?
  modelo             Int
  capacidadPasajeros Int           @default(0)
  capacidadCarga     Float         @default(0) // toneladas
  estado             VehicleStatus @default(DISPONIBLE)
  kilometraje        Int           @default(0)
  empresaAfiliadora  String?
  observaciones      String?

  // Vencimientos clave (los detalles completos van en Document)
  soatVence          DateTime?
  tecnomecanicaVence DateTime?
  tarjetaOperVence   DateTime?

  documents          Document[]
  maintenances       Maintenance[]
  assignments        VehicleAssignment[]
  services           Service[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// ============================================================
// MÓDULOS 2 + 3 — CONDUCTORES + GESTIÓN HUMANA
// ============================================================

enum DriverStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  VACACIONES
}

model Driver {
  id                  String       @id @default(cuid())
  fullName            String
  documento           String       @unique
  licencia            String
  categoriaLicencia   String       // C1, C2, C3...
  licenciaVence       DateTime
  direccion           String?
  residenciaLat       Float?
  residenciaLng       Float?
  telefono            String?
  contactoEmergencia  String?
  estado              DriverStatus @default(ACTIVO)
  observaciones       String?

  documents           Document[]
  assignments         VehicleAssignment[]
  services            Service[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// Asignación vehículo-conductor (fija o temporal)
enum AssignmentType {
  FIJA
  TEMPORAL
}

model VehicleAssignment {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      AssignmentType @default(FIJA)
  fromDate  DateTime       @default(now())
  toDate    DateTime?
  active    Boolean        @default(true)

  @@index([vehicleId])
  @@index([driverId])
}

// ============================================================
// MÓDULO documental (vehículos + gestión humana)
// ============================================================

enum DocumentType {
  // Vehículo
  SOAT
  TECNOMECANICA
  TARJETA_OPERACION
  SEGURO_CONTRACTUAL
  SEGURO_EXTRACONTRACTUAL
  // Conductor
  HOJA_DE_VIDA
  CONTRATO
  EPS
  ARL
  CERTIFICADO
  COMPARENDO
  EXAMEN_MEDICO
  PRUEBA_MANEJO
  LICENCIA_CONDUCCION
  // Genérico
  OTRO
}

model Document {
  id          String       @id @default(cuid())
  type        DocumentType
  name        String
  fileUrl     String?      // ruta al archivo (S3 / local)
  issuedAt    DateTime?
  expiresAt   DateTime?
  notes       String?

  vehicleId   String?
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([vehicleId])
  @@index([driverId])
  @@index([expiresAt])
}

// ============================================================
// MÓDULO mantenimiento
// ============================================================

enum MaintenanceType {
  PREVENTIVO
  CORRECTIVO
  CAMBIO_ACEITE
  LLANTAS
  FRENOS
  OTRO
}

model Maintenance {
  id                  String          @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type                MaintenanceType
  description         String
  taller              String?
  cost                Float           @default(0)
  performedAt         DateTime        @default(now())
  kilometraje         Int?
  nextDate            DateTime?
  nextKilometraje     Int?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([vehicleId])
}

// ============================================================
// MÓDULO 5 — CONTRATOS Y FORMULARIOS DINÁMICOS
// ============================================================

enum FieldType {
  TEXT
  NUMBER
  DATE
  TIME
  SELECT
  ADDRESS
  COORDS
  FILE
  TEXTAREA
}

model Contract {
  id          String         @id @default(cuid())
  name        String
  cliente     String
  description String?
  active      Boolean        @default(true)
  fields      ContractField[]
  services    Service[]
  products    Product[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ContractField {
  id           String     @id @default(cuid())
  contractId   String
  contract     Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  key          String     // identifier interno
  label        String
  type         FieldType
  required     Boolean    @default(false)
  options      String?    // JSON array para SELECT
  order        Int        @default(0)

  @@index([contractId])
}

// ============================================================
// MÓDULO 6 — SERVICIOS
// ============================================================

enum ServiceStatus {
  PENDIENTE
  ASIGNADO
  EN_EJECUCION
  COMPLETADO
  CANCELADO
}

model Service {
  id              String         @id @default(cuid())
  code            String         @unique @default(cuid())
  contractId      String
  contract        Contract       @relation(fields: [contractId], references: [id])
  cliente         String
  fecha           DateTime
  hora            String?        // HH:mm
  pasajeros       Int            @default(1)
  origen          String
  origenLat       Float?
  origenLng       Float?
  destino         String
  destinoLat      Float?
  destinoLng      Float?
  parada1         String?
  parada2         String?
  parada3         String?
  tipoVehiculo    String?
  observaciones   String?

  // Datos dinámicos según contrato (JSON)
  dynamicData     String?        // JSON stringified

  status          ServiceStatus  @default(PENDIENTE)

  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id])
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id])

  // Ruta calculada
  routeJson       String?        // JSON de Google Directions / ruta manual
  distanciaKm     Float?
  duracionMin     Int?
  rutaManual      Boolean        @default(false)

  // Financiero
  valorTotal      Float          @default(0)
  costoTotal      Float          @default(0)
  items           ServiceItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([fecha])
  @@index([contractId])
  @@index([vehicleId])
  @@index([driverId])
}

// ============================================================
// MÓDULO 9 — FINANCIERO
// ============================================================

model Product {
  id          String   @id @default(cuid())
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  code        String   @unique
  name        String   // Ruta base, Hora adicional, Espera, Peaje, Recargo nocturno...
  unitPrice   Float
  cost        Float    @default(0)
  active      Boolean  @default(true)
  items       ServiceItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceItem {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Float   @default(1)
  unitPrice  Float
  cost       Float   @default(0)
  total      Float

  @@index([serviceId])
}
